{
  "name": "crystal-ui-studio",
  "version": "1.0.0",
  "private": true,
  "description": "CRYSTAL UI — developer-led web development studio website",
  "source": "src/index.html",
  "scripts": {
    "start": "parcel src/index.html --port 3000",
    "build": "npm run clean && parcel build src/index.html --dist-dir dist --public-url / --no-source-maps && node scripts/postbuild.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.parcel-cache',{recursive:true,force:true})\""
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@fontsource/didact-gothic": "^5.3.0",
    "@parcel/transformer-sass": "^2.16.4",
    "opentype.js": "^2.0.0",
    "parcel": "^2.16.4",
    "sass": "^1.105.1"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
